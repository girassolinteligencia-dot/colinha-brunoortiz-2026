# Configuração oficial de Headers de Segurança e Cache para Cloudflare Pages - Bruno Ortiz 10222

# 1. Regras globais de segurança HTTP para todos os arquivos
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none';

# 2. HTML principal e Manifesto: Sem cache para carregar sempre a versão mais recente sem refresh
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate

# 3. Service Worker
/service-worker.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# 4. Dataset JSON de candidatos: Revalidação rápida
/data.json
  Cache-Control: public, max-age=300, must-revalidate

# 5. Assets estáticos pesados
/assets/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# 6. Painel de Inteligência e API: Bloqueio de indexação
/painel*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  Cache-Control: no-cache, no-store, must-revalidate

/api/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  Cache-Control: no-cache, no-store, must-revalidate
